# ── devora env template ──────────────────────────────────────────────────
# Copy to `.env.local` and fill in real values. All values except the two
# NEXT_PUBLIC_* Supabase ones are server-only and must never be exposed to the
# browser. Every integration degrades gracefully when its vars are absent, so
# local dev / previews still run (chat falls back to a canned reply, email logs
# instead of sending, etc.).

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon key are safe to expose (needed for browser Realtime).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key BYPASSES row-level security — server-only, keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model overrides (defaults are set in lib/anthropic.ts).
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5
# ANTHROPIC_SUMMARY_MODEL=claude-opus-4-8

# ── Upstash Redis (rate limiting) ───────────────────────────────────────────
# Optional: without these, rate limiting is skipped (fine for local dev).
# In production set them: the calculator/contact endpoints rely on it to cap
# abuse (5/hour per IP and 3/hour per email).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Zoho Mail SMTP (calculator + contact + lead + support emails) ───────────
# App-specific password, NOT your login password. If neither SMTP nor Supabase
# is configured, calculator/contact submissions return a retryable 503 (they
# never pretend to succeed).
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
# Optional: force TLS mode (default: true only for port 465). Used by the local
# SMTP integration test (tests/email-smtp.mjs) on a plain port.
# ZOHO_SMTP_SECURE=false
# DESTINATION of every lead/enquiry email — Devora's business inbox. Defaults
# to ZOHO_SMTP_USER when empty. The visitor's address is only ever the Reply-To.
CONTACT_TO=

# ── Test-only ───────────────────────────────────────────────────────────────
# `memory` swaps Supabase for an in-memory lead store (Playwright E2E). Ignored
# when NODE_ENV=production or VERCEL is set — it cannot be enabled in prod.
# LEADS_TEST_REPOSITORY=memory

# ── Auto-close idle conversations ───────────────────────────────────────────
# Conversations with no message for this many minutes are auto-closed by the
# Vercel Cron job (vercel.json → /api/cron/close-stale). Default 15.
AUTO_CLOSE_MINUTES=15
# Protects the cron endpoint. Set the same value here and in Vercel; Vercel
# sends it as a Bearer token on scheduled runs. Optional (the action is
# idempotent) but recommended.
CRON_SECRET=
